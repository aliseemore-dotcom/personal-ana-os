# ───────────── Which data the app shows ─────────────
# sheets   = the Google Sheets Data Hub, through this app's own /api (production)
# supabase = Supabase (needs the two VITE_SUPABASE_* values below)
# local    = demo data in the browser (development and the static preview)
VITE_DATA_SOURCE=local

# ───────────── Google Sheets Data Hub (SERVER-SIDE ONLY) ─────────────
# These are read by the /api functions on Vercel. They are NOT prefixed VITE_, so they can never
# reach the browser. Set them in Vercel → Project → Settings → Environment Variables, never in git.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, exactly as in its JSON file (newlines may stay as \n).
GOOGLE_PRIVATE_KEY=
# Leave unset or false for read-only access (the minimum permission). Set to true only when the app
# should write back; then share the sheet with the service account as Editor.
GOOGLE_SHEETS_WRITE=false
# How long a read of the sheet stays fresh on the server, in seconds (default 30).
SHEETS_CACHE_SECONDS=30
# The key typed once in the browser to open the dashboard. Without it the API refuses everyone.
# Make it long and random, for example: openssl rand -base64 32
DASHBOARD_ACCESS_KEY=

# ───────────── Supabase (only when VITE_DATA_SOURCE=supabase) ─────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────────── Personalisation ─────────────
VITE_USER_NAME=Anastasija
VITE_LOCALE=en-GB
VITE_WEATHER_LAT=51.5072
VITE_WEATHER_LON=-0.1276
VITE_CALENDAR_PROVIDER=mock
